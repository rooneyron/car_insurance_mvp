graph TB
    %% 全局样式调整，让子图自带浅色背景，节点紧凑
    classDef default fill:#f4f4f9,stroke:#666,stroke-width:1.5px,color:#333;
    classDef endNode fill:#ffcccc,stroke:#cc0000,stroke-width:2px,color:#000;

    END_NODE(("END")):::endNode

    %% ================= 用户层 (水平排列，压缩高度) =================
    subgraph 用户层
        direction LR
        A["Gradio 前端<br/>src/gradio_ui.py"]
        B["REST API<br/>POST /chat · GET /visits<br/>src/api.py"]
        FS["飞书机器人<br/>src/feishu/feishu_bot.py"]
    end

    %% ================= 对话调度层 =================
    subgraph 对话调度层
        C["chat_api_stream<br/>src/chat.py<br/>输入校验 · Token限额 · 流式终局确认"]
    end

    %% ================= LangGraph 核心状态机 =================
    subgraph LangGraph StateGraph
        direction TB
        D["router 节点<br/>src/router/<br/>五层漏斗"]
        D2["prepare_input 节点<br/>src/chains/chains.py"]
        E["agent 节点<br/>异步流式 · bind_tools<br/>astream 流式直出"]
        F["tools 节点<br/>ToolNode · 短路检测<br/>转人工/RAG空结果 → direct_response"]
        
        D -->|"route"| D2
        D2 --> E
        E -->|"有 tool_calls"| F
        F -->|"ReAct 循环"| E
    end

    %% ================= 底层：基础设施与工具层 (横向并排，节省纵向空间) =================
    subgraph 底层模块
        direction LR
        
        subgraph 基础设施
            direction TB
            N["LLM 推理<br/>DeepSeek + qwen-turbo"]
            O["MemorySaver<br/>对话记忆 · thread_id 隔离"]
            P["SummarizationNode<br/>2000 token → 500 token"]
            MEM["长期记忆<br/>sqlite结构化 + PG语义向量"]
            VC["访问计数器<br/>src/visit_counter.py"]
        end
        
        subgraph 工具层
            direction TB
            H["calculate_premium<br/>保费估算"]
            I["query_policy<br/>保单查询"]
            K["transfer_to_human<br/>转人工"]
            J["search_insurance_terms<br/>条款检索 RAG"]
            
            subgraph RAG检索层
                direction TB
                L["ParadeDB 双路召回<br/>pgvector(HNSW) + pg_search(BM25)"]
                M["RRF融合(K=60) → 精排(top3)<br/>本地: BGE-Reranker · 生产: qwen3-rerank"]
                L --> M
            end
            
            J --> L
        end
    end

    %% ================= 核心流向连线 =================
    %% 接入层到调度层
    A --> C
    B --> C
    FS -->|"chat_api"| C

    %% 调度层到状态机
    C -->|"state.graph.astream_events"| D

    %% 状态机内部到 END 的出口
    D -->|"clarify/handoff"| END_NODE
    E -->|"无 tool_calls"| END_NODE
    F -->|"direct_response 非空 · 短路直返"| END_NODE

    %% 工具节点调用底层工具
    F --> H
    F --> I
    F --> J
    F --> K

    %% 基础设施与上层的关系 (使用虚线，尽量缩短连线路径)
    E -.-> N
    D -.-> O
    D -.-> P
    C -.->|"异步提取"| MEM
    
    %% 访问计数器关系
    A -.->|"页面加载"| VC
    B -.->|"GET /visits"| VC
